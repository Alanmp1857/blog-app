<!DOCTYPE html>
<html lang="en">

<head>
    <%- include ('partials/head') %>
        <title>Create an account | Ink & Ideas</title>
</head>

<body>
    <%- include ('partials/nav') %>
    <main class="auth-page">
        <section class="auth-card">
            <div class="auth-aside signup-aside">
                <span class="auth-aside-mark">✳</span>
                <p>A community built around the joy of sharing what matters.</p>
                <span class="auth-aside-caption">READ A LITTLE. WRITE A LOT.</span>
            </div>
            <div class="auth-content">
                <span class="eyebrow">Come on in</span>
                <h1>Make yourself<br>at home.</h1>
                <p class="auth-intro">Create an account and add your voice to the conversation.</p>
                <form action="/user/signup" method="POST" class="auth-form">
                    <div class="mb-3">
                        <label for="fullName" class="form-label">Full name</label>
                        <input type="text" class="form-control form-control-lg" name="fullName" id="fullName" autocomplete="name" placeholder="Your name" required>
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">Email address</label>
                        <input type="email" class="form-control form-control-lg" name="email" id="email" autocomplete="email" placeholder="you@example.com" required>
                    </div>
                    <div class="mb-4">
                        <label for="password" class="form-label">Password</label>
                        <input type="password" class="form-control form-control-lg" name="password" id="password" autocomplete="new-password" placeholder="Choose a password" required>
                    </div>
                    <button type="submit" class="btn btn-accent auth-submit">Create account <span aria-hidden="true">→</span></button>
                </form>
                <p class="auth-switch">Already have an account? <a href="/user/signin">Sign in</a></p>
            </div>
        </section>
    </main>
    <%- include ('partials/scripts') %>
</body>

</html>